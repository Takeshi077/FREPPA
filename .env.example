# Copy to `.env` for local development, or set these as Environment
# Variables inside Render / your hosting dashboard.

# ---- Database (MySQL / TiDB Cloud compatible) ----
# TiDB Cloud Serverless example:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=freppa_school
# TLS (required by TiDB Cloud Serverless, auto-detected for *.tidbcloud.com hosts)
DB_SSL=true

# Alternative to the above: a single MySQL connection string
# DATABASE_URL=mysql://user:password@host:4000/freppa_school

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# ---- Server ----
PORT=3000

# ---- Email (optional, for contact form) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=info@freppagroupofschools.edu