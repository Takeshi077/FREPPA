# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Database (use DATABASE_URL for Railway/hosted MySQL, otherwise the DB_* values)
# DATABASE_URL=mysql://user:password@host:3306/database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=freppa_school
DB_PORT=3306

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3999

# Contact form / email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
